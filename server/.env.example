# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Required. Server-side only. Never exposed to any client.
GEMINI_API_KEY=your_real_gemini_api_key_here

# Optional. Port the gateway listens on.
PORT=8787

# Optional. Interface the gateway binds to. Defaults to 127.0.0.1 (loopback
# only). A non-loopback bind requires MACSENSE_CLIENT_TOKEN to be set — the
# gateway refuses to start tokenless on a reachable interface.
HOST=127.0.0.1

# Optional. Comma-separated list of allowed CORS origins.
# Example: https://app.macsense.ai,http://localhost:3000
CORS_ORIGINS=

# Required in production (NODE_ENV=production) and on any non-loopback HOST.
# If set, incoming requests must send `Authorization: Bearer <token>` matching
# this value. Without it the gateway refuses to start in production, and the
# /v1/ari/chat gate refuses every request (fails closed, audit M-1).
MACSENSE_CLIENT_TOKEN=

# Optional. Requests per window per IP for the rate limiter.
RATE_LIMIT_MAX=30

# Optional. Rate limit window size in milliseconds.
RATE_LIMIT_WINDOW_MS=60000

# Optional. Gemini model id used for generateContent calls.
GEMINI_MODEL=gemini-2.0-flash
